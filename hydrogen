    // ============ DRAG & DROP SYSTEM ============
    setupDragAndDrop() {
        // Make sidebar elements draggable
        document.querySelectorAll('.element-item').forEach(item => {
            item.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('elementType', item.dataset.type);
                item.classList.add('dragging');
            });
            
            item.addEventListener('dragend', (e) => {
                item.classList.remove('dragging');
            });
        });
        
        // Canvas drop handling
        this.canvas.addEventListener('dragover', (e) => {
            e.preventDefault();
            const dropZone = this.getDropZone(e.target);
            if (dropZone) {
                this.highlightDropZone(dropZone);
            }
        });
        
        this.canvas.addEventListener('dragleave', (e) => {
            this.clearDropHighlights();
        });
        
        this.canvas.addEventListener('drop', (e) => {
            e.preventDefault();
            const elementType = e.dataTransfer.getData('elementType');
            const dropZone = this.getDropZone(e.target);
            
            if (elementType && dropZone) {
                this.createElement(elementType, dropZone);
            }
            this.clearDropHighlights();
        });
        
        // Enable reordering of existing elements
        this.canvas.addEventListener('dragover', (e) => {
            const draggedElement = e.target.closest('.canvas-element');
            if (draggedElement && draggedElement !== this.selectedElement) {
                e.preventDefault();
                this.showDropIndicator(draggedElement, e);
            }
        });
    }
    
    getDropZone(target) {
        // Find the closest drop zone
        if (target.classList.contains('canvas-element')) {
            return target;
        } else if (target.classList.contains('column-content')) {
            return target.closest('.canvas-element');
        } else if (target.classList.contains('email-canvas')) {
            return this.canvas;
        }
        return this.canvas;
    }
    
    highlightDropZone(dropZone) {
        this.clearDropHighlights();
        if (dropZone) {
            dropZone.classList.add('drop-highlight');
        }
    }
    
    clearDropHighlights() {
        document.querySelectorAll('.drop-highlight').forEach(el => {
            el.classList.remove('drop-highlight');
        });
    }
    
    showDropIndicator(targetElement, event) {
        const indicator = document.createElement('div');
        indicator.className = 'drop-indicator';
        
        const rect = targetElement.getBoundingClientRect();
        const mouseY = event.clientY;
        const elementMiddle = rect.top + (rect.height / 2);
        
        if (mouseY < elementMiddle) {
            targetElement.parentNode.insertBefore(indicator, targetElement);
        } else {
            targetElement.parentNode.insertBefore(indicator, targetElement.nextSibling);
        }
    }
    
    // ============ ELEMENT CREATION ============
    createElement(type, targetZone) {
        const element = this.buildElement(type);
        if (!element) return;
        
        // Save state for undo
        this.saveState();
        
        // Insert into canvas
        if (targetZone === this.canvas) {
            this.canvas.appendChild(element);
        } else if (targetZone.classList.contains('column-content')) {
            targetZone.appendChild(element);
        } else if (targetZone.classList.contains('canvas-element')) {
            targetZone.parentNode.insertBefore(element, targetZone.nextSibling);
        }
        
        // Remove empty message if present
        const emptyMessage = document.getElementById('emptyCanvasMessage');
        if (emptyMessage) {
            emptyMessage.remove();
        }
        
        // Select the new element
        this.selectElement(element);
        
        // Enable reordering
        this.enableElementReordering(element);
        
        // Update undo/redo buttons
        this.updateUndoRedoButtons();
        
        // Auto-save
        this.saveToLocalStorage();
    }
    
