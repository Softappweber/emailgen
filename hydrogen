    // ============ IMAGE HANDLING ============
    changeImage(elementId) {
        this.currentImageElement = elementId;
        const modal = new bootstrap.Modal(document.getElementById('imageUploadModal'));
        modal.show();
    }
    
    handleImageUpload(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                this.updateImageSrc(this.currentImageElement, e.target.result);
                bootstrap.Modal.getInstance(document.getElementById('imageUploadModal')).hide();
            };
            reader.readAsDataURL(file);
        }
    }
    
    addImageFromUrl() {
        const url = document.getElementById('imageUrlInput').value.trim();
        if (url && this.currentImageElement) {
            this.updateImageSrc(this.currentImageElement, url);
            bootstrap.Modal.getInstance(document.getElementById('imageUploadModal')).hide();
            document.getElementById('imageUrlInput').value = '';
        }
    }
    
    // ============ EXPORT ============
    exportHTML() {
        const canvasHTML = this.canvas.innerHTML;
        const fullHTML = `
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${this.templateName}</title>
