    // ============ STYLE UPDATES ============
    updateElementStyle(elementId, property, value) {
        const element = document.getElementById(elementId);
        if (element) {
            const content = element.querySelector('.element-content');
            if (content) {
                content.style[property] = value;
                this.saveToLocalStorage();
            }
        }
    }
    
    updateTextStyle(elementId, property, value) {
        const element = document.getElementById(elementId);
        if (element) {
            const content = element.querySelector('.element-content');
            if (content) {
                content.style[property] = value;
                this.saveToLocalStorage();
            }
        }
    }
    
    changeHeadingLevel(elementId, level) {
        const element = document.getElementById(elementId);
        if (element) {
            const oldHeading = element.querySelector('h1, h2, h3, h4');
            if (oldHeading) {
                const newHeading = document.createElement(level);
                newHeading.innerHTML = oldHeading.innerHTML;
                newHeading.style.cssText = oldHeading.style.cssText;
                oldHeading.parentNode.replaceChild(newHeading, oldHeading);
                this.saveToLocalStorage();
            }
        }
    }
    
    updateButtonText(elementId, text) {
        const element = document.getElementById(elementId);
        if (element) {
            const button = element.querySelector('.email-button');
            if (button) {
                button.textContent = text;
                this.saveToLocalStorage();
            }
        }
    }
    
    updateButtonUrl(elementId, url) {
        const element = document.getElementById(elementId);
        if (element) {
            const button = element.querySelector('.email-button');
            if (button) {
                button.href = url;
                this.saveToLocalStorage();
            }
        }
    }
    
    updateButtonStyle(elementId, property, value) {
        const element = document.getElementById(elementId);
        if (element) {
            const button = element.querySelector('.email-button');
            if (button) {
                button.style[property] = value;
                this.saveToLocalStorage();
            }
        }
    }
    
    updateImageSrc(elementId, src) {
        const element = document.getElementById(elementId);
        if (element) {
            const img = element.querySelector('img');
            if (img) {
                img.src = src;
                this.saveToLocalStorage();
            }
        }
    }
    
    updateImageAlt(elementId, alt) {
        const element = document.getElementById(elementId);
        if (element) {
            const img = element.querySelector('img');
            if (img) {
                img.alt = alt;
                this.saveToLocalStorage();
            }
        }
    }
    
    updateImageWidth(elementId, width) {
        const element = document.getElementById(elementId);
        if (element) {
            const img = element.querySelector('img');
            if (img) {
                img.style.width = width;
                this.saveToLocalStorage();
            }
        }
    }
    
    updateImageLink(elementId, link) {
        const element = document.getElementById(elementId);
        if (element) {
            const img = element.querySelector('img');
            if (img) {
                img.parentNode.href = link;
                this.saveToLocalStorage();
            }
        }
    }
    
    // ============ ELEMENT OPERATIONS ============
    duplicateElement(elementId) {
        const element = document.getElementById(elementId);
        if (element) {
            const clone = element.cloneNode(true);
            clone.id = `element-${++this.elementCounter}`;
            clone.classList.remove('selected');
            
            // Clear the toolbar events in clone
            const toolbar = clone.querySelector('.element-toolbar');
            if (toolbar) {
                toolbar.style.display = 'none';
            }
            
            element.parentNode.insertBefore(clone, element.nextSibling);
            this.selectElement(clone);
            this.enableElementReordering(clone);
            this.saveState();
            this.saveToLocalStorage();
        }
    }
    
    deleteElement(elementId) {
        const element = document.getElementById(elementId);
        if (element) {
            if (confirm('Delete this element?')) {
                this.saveState();
                element.remove();
                this.selectedElement = null;
                document.getElementById('propertiesContent').innerHTML = `
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-cursor" style="font-size: 2rem;"></i>
                        <p class="mt-3">Select an element to edit its properties</p>
                    </div>
                `;
                this.saveToLocalStorage();
            }
        }
    }
    
    moveElement(elementId, direction) {
        const element = document.getElementById(elementId);
        if (element) {
            if (direction === 'up' && element.previousElementSibling) {
                element.parentNode.insertBefore(element, element.previousElementSibling);
            } else if (direction === 'down' && element.nextElementSibling) {
                element.parentNode.insertBefore(element.nextElementSibling, element);
            }
            this.saveToLocalStorage();
        }
    }
    
    enableElementReordering(element) {
        element.addEventListener('click', (e) => {
            if (!e.target.closest('.element-toolbar')) {
                this.selectElement(element);
            }
        });
        
        // Make content editable where applicable
        const editableContent = element.querySelector('[contenteditable="true"]');
        if (editableContent) {
            editableContent.addEventListener('blur', () => {
                this.saveToLocalStorage();
            });
        }
    }
    
    // ============ DEVICE PREVIEW ============
    setDevice(device) {
        this.currentDevice = device;
        const canvas = this.canvas;
        
        // Remove all device classes
        canvas.classList.remove('mobile-view', 'tablet-view');
        
        // Add the appropriate class
        if (device === 'mobile') {
            canvas.classList.add('mobile-view');
        } else if (device === 'tablet') {
            canvas.classList.add('tablet-view');
        }
        
        // Update buttons
        document.querySelectorAll('.device-toggle button').forEach(btn => {
            btn.classList.remove('active');
            if (btn.dataset.device === device) {
                btn.classList.add('active');
            }
        });
    }
    
    // ============ ZOOM CONTROLS ============
    zoomIn() {
        if (this.zoomLevel < 150) {
            this.zoomLevel += 10;
            this.applyZoom();
        }
    }
    
    zoomOut() {
        if (this.zoomLevel > 50) {
            this.zoomLevel -= 10;
            this.applyZoom();
        }
    }
    
    applyZoom() {
        document.getElementById('zoomLevel').textContent = this.zoomLevel + '%';
        this.canvas.style.transform = `scale(${this.zoomLevel / 100})`;
        this.canvas.style.transformOrigin = 'top center';
    }
    
    // ============ UNDO/REDO ============
    saveState() {
        this.undoStack.push(this.canvas.innerHTML);
        this.redoStack = [];
        this.updateUndoRedoButtons();
        
        // Limit undo stack to 50 states
        if (this.undoStack.length > 50) {
            this.undoStack.shift();
        }
    }
    
    undo() {
        if (this.undoStack.length > 0) {
            const currentState = this.canvas.innerHTML;
            this.redoStack.push(currentState);
            const previousState = this.undoStack.pop();
            this.canvas.innerHTML = previousState;
            this.updateUndoRedoButtons();
            this.saveToLocalStorage();
        }
    }
    
    redo() {
        if (this.redoStack.length > 0) {
            const currentState = this.canvas.innerHTML;
            this.undoStack.push(currentState);
            const nextState = this.redoStack.pop();
            this.canvas.innerHTML = nextState;
            this.updateUndoRedoButtons();
            this.saveToLocalStorage();
        }
    }
    
    updateUndoRedoButtons() {
        // Update button states if needed
    }
    
    // ============ KEYBOARD SHORTCUTS ============
    setupKeyboardShortcuts() {
        document.addEventListener('keydown', (e) => {
            // Ctrl/Cmd + Z: Undo
            if ((e.ctrlKey || e.metaKey) && e.key === 'z' && !e.shiftKey) {
                e.preventDefault();
                this.undo();
            }
            // Ctrl/Cmd + Shift + Z or Ctrl/Cmd + Y: Redo
            else if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || (e.key === 'z' && e.shiftKey))) {
                e.preventDefault();
                this.redo();
            }
            // Delete key: Delete selected element
            else if (e.key === 'Delete' && this.selectedElement) {
                e.preventDefault();
                this.deleteElement(this.selectedElement.id);
            }
            // Ctrl/Cmd + D: Duplicate
            else if ((e.ctrlKey || e.metaKey) && e.key === 'd' && this.selectedElement) {
                e.preventDefault();
                this.duplicateElement(this.selectedElement.id);
            }
        });
    }
    
