</body>
</html>`;
        
        this.downloadFile(fullHTML, `${this.templateName.toLowerCase().replace(/\s+/g, '-')}.html`, 'text/html');
    }
    
    downloadFile(content, filename, type) {
        const blob = new Blob([content], { type: type });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
    }
    
    // ============ LOCAL STORAGE ============
    saveToLocalStorage() {
        const data = {
            canvasHTML: this.canvas.innerHTML,
            templateName: this.templateName,
            products: this.products,
            timestamp: new Date().toISOString()
        };
        localStorage.setItem('emailDesignerState', JSON.stringify(data));
    }
    
    loadFromLocalStorage() {
        const saved = localStorage.getItem('emailDesignerState');
        if (saved) {
            try {
                const data = JSON.parse(saved);
                if (data.canvasHTML) {
                    this.canvas.innerHTML = data.canvasHTML;
                    this.templateName = data.templateName || 'Untitled Template';
                    this.products = data.products || [];
                    document.getElementById('templateName').value = this.templateName;
                    
                    // Remove empty message if there are elements
                    const emptyMessage = document.getElementById('emptyCanvasMessage');
                    if (emptyMessage && this.canvas.children.length > 1) {
                        emptyMessage.remove();
                    }
                }
            } catch (error) {
                console.error('Error loading saved state:', error);
            }
        }
    }
    
